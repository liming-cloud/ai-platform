FOUNDATION_POSTGRES_DATABASE=foundation_v1
FOUNDATION_POSTGRES_USER=foundation_app
FOUNDATION_POSTGRES_PASSWORD=local-demo-postgres-password
FOUNDATION_LOCAL_PLATFORM_ADMIN_LOGIN=admin
FOUNDATION_LOCAL_PLATFORM_ADMIN_PASSWORD=admin@123
FOUNDATION_REDIS_PASSWORD=local-demo-redis-password
FOUNDATION_MINIO_USER=foundation_demo
FOUNDATION_MINIO_PASSWORD=local-demo-minio-password
# 仅供本地 Compose 演示使用；非本地环境必须替换为受控随机主密钥，且不得提交真实值。
FOUNDATION_MODEL_CREDENTIALS_LOCAL_DEVELOPMENT_KEY_VERSION=M2_V1
FOUNDATION_SECRET_ENCRYPTION_KEY_M2_V1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 演示配额是非秘密运行参数，页面与服务端必须使用同一真实限制。
FOUNDATION_QUERY_QUOTA_DAILY_LIMIT=100
FOUNDATION_QUERY_QUOTA_CONCURRENT_LIMIT=4
FOUNDATION_QUERY_QUOTA_RUNNING_LEASE=PT2M
