# Copy to deploy/.env, replace every replace-* value, then invoke Compose with
# --env-file deploy/.env. The preflight container rejects these placeholders.
AIP_BIND_ADDRESS=127.0.0.1

AIP_POSTGRES_DB=aip
# Deploy-only schema owner/migrator. The backend never receives this credential.
AIP_POSTGRES_USER=aip_local
AIP_POSTGRES_PASSWORD=replace-postgres-password-with-random-characters
# Least-privilege backend login; must differ from the migrator role and secret.
AIP_POSTGRES_RUNTIME_USER=aip_runtime
AIP_POSTGRES_RUNTIME_PASSWORD=replace-postgres-runtime-password-with-random-characters

# The only initialized login is tenant 2001/admin. The cleartext remains only in
# the gitignored mode-0600 deploy/.env; only its hash reaches PostgreSQL.
AIP_BOOTSTRAP_ADMIN_PASSWORD=replace-bootstrap-admin-password-with-random-characters
AIP_BOOTSTRAP_ADMIN_PASSWORD_HASH='replace-bootstrap-admin-password-hash'

AIP_REDIS_PORT=6379

# Shared by the SeaweedFS S3 endpoint and the backend. The endpoint only exposes
# the configured private bucket on loopback in the local deployment.
AIP_MINIO_SERVICE_ACCESS_KEY=aip_backend_storage
AIP_MINIO_SERVICE_SECRET_KEY=replace-minio-service-secret-key-with-random-characters
AIP_MINIO_API_PORT=9000
AIP_OBJECT_STORAGE_BUCKET=aip-knowledge
AIP_OBJECT_STORAGE_REGION=us-east-1
AIP_MULTIPART_MAX_FILE_SIZE=12MB
AIP_MULTIPART_MAX_REQUEST_SIZE=12MB

AIP_ROCKETMQ_NAMESRV_PORT=9876
AIP_ROCKETMQ_BROKER_PORT=10911
AIP_ROCKETMQ_FAST_PORT=10909

AIP_BACKEND_PORT=8080
AIP_FRONTEND_PORT=5173
AIP_SESSION_TIMEOUT_SECONDS=28800
AIP_IDENTITY_ACTIVATION_BASE_URL=http://127.0.0.1:5173/activate
AIP_IDENTITY_INVITATION_SIGNING_KEY=replace-invitation-signing-key-with-random-characters
AIP_IDENTITY_INVITATION_OUTBOX_KMS_KEY_ID=replace-invitation-outbox-kms-key-id-with-unique-identifier
AIP_IDENTITY_INVITATION_OUTBOX_ENCRYPTION_KEY=replace-invitation-outbox-encryption-key-with-random-characters
# Comma-separated keyId=keyMaterial entries. Keep empty until a rotation.
AIP_IDENTITY_INVITATION_OUTBOX_PREVIOUS_KEYS=
AIP_MODEL_HUB_SECRET_KMS_KEY_ID=replace-model-kms-key-id-with-unique-identifier
AIP_MODEL_HUB_SECRET_ENCRYPTION_KEY=replace-model-encryption-key-with-random-characters
# Comma-separated keyId=keyMaterial entries. Keep empty until a rotation.
AIP_MODEL_HUB_SECRET_PREVIOUS_KEYS=
AIP_MODEL_HUB_SECRET_ROTATION_ENABLED=false
AIP_MODEL_HUB_SECRET_ROTATION_BATCH_SIZE=20
AIP_MODEL_HUB_SECRET_ROTATION_POLL_DELAY_MS=5000
AIP_MODEL_HUB_LOCAL_DETERMINISTIC_ENABLED=true

AIP_IDENTITY_INVITATION_MAIL_ENABLED=false
AIP_IDENTITY_INVITATION_MAIL_FROM=no-reply@example.invalid
AIP_SMTP_HOST=mail.example.invalid
AIP_SMTP_PORT=25
AIP_SMTP_USERNAME=
AIP_SMTP_PASSWORD=
AIP_SMTP_AUTH=false
AIP_SMTP_STARTTLS=false

AIP_SPRING_AI_EMBEDDING_OPENAI_COMPATIBLE_ENABLED=false
AIP_SPRING_AI_EMBEDDING_OPENAI_COMPATIBLE_BASE_URL=
AIP_SPRING_AI_EMBEDDING_OPENAI_COMPATIBLE_API_KEY=
AIP_SPRING_AI_EMBEDDING_OPENAI_COMPATIBLE_DIMENSIONS=1536
