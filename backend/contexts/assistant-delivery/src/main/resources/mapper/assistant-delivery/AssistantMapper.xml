<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiplatform.foundation.assistantdelivery.infrastructure.persistence.assistant.mapper.AssistantMapper">

    <resultMap id="assistantRow" type="com.aiplatform.foundation.assistantdelivery.infrastructure.persistence.assistant.entity.AssistantEntity">
        <result column="tenant_id" property="tenantId"/>
        <result column="id" property="id"/>
        <result column="display_name" property="displayName"/>
        <result column="latest_version_number" property="latestVersionNumber"/>
        <result column="version" property="version"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <resultMap id="publishedAssistantRow" type="com.aiplatform.foundation.assistantdelivery.infrastructure.persistence.assistant.projection.PublishedAssistantRow">
        <result column="assistant_id" property="assistantId"/>
        <result column="display_name" property="displayName"/>
        <result column="assistant_version_id" property="assistantVersionId"/>
        <result column="version_number" property="versionNumber"/>
        <result column="published_at" property="publishedAt"/>
    </resultMap>

    <select id="lockScope" resultType="java.lang.String">
        <![CDATA[
        SELECT pg_advisory_xact_lock(
            hashtextextended(#{scope}, 20260730)
        )
        ]]>
    </select>

    <select id="findAssistantForUpdate" resultMap="assistantRow">
        <![CDATA[
        SELECT tenant_id,
               id,
               display_name,
               latest_version_number,
               version,
               created_by,
               created_at
        FROM assistant_delivery.assistant
        WHERE tenant_id = #{tenantId}
          AND id = #{assistantId}
        FOR UPDATE
        ]]>
    </select>

    <select id="findPublishedPage" resultMap="publishedAssistantRow">
        WITH latest_published AS (
            SELECT DISTINCT ON (assistant.id)
                   assistant.id AS assistant_id,
                   assistant.display_name,
                   version.id AS assistant_version_id,
                   version.version_number,
                   version.published_at
            FROM assistant_delivery.assistant AS assistant
            JOIN assistant_delivery.assistant_version AS version
              ON version.tenant_id = assistant.tenant_id
             AND version.assistant_id = assistant.id
            WHERE assistant.tenant_id = #{tenantId}
              AND version.status = 'PUBLISHED'
            <if test="filter.q != ''">
              AND position(lower(#{filter.q}) in lower(assistant.display_name)) &gt; 0
            </if>
            <if test="!filter.allPublished">
              <choose>
                <when test="filter.assistantIds.size() > 0">
                  AND assistant.id IN
                  <foreach collection="filter.assistantIds" item="id" open="(" separator="," close=")">#{id}</foreach>
                </when>
                <otherwise>AND FALSE</otherwise>
              </choose>
            </if>
            ORDER BY assistant.id,
                     version.version_number DESC,
                     version.id DESC
        )
        SELECT assistant_id::text AS assistant_id,
               display_name,
               assistant_version_id::text AS assistant_version_id,
               version_number,
               published_at
        FROM latest_published
        ORDER BY published_at DESC, assistant_version_id DESC
    </select>

</mapper>
