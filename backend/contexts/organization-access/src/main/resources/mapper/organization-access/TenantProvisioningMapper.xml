<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiplatform.foundation.organizationaccess.infrastructure.persistence.tenant.mapper.TenantProvisioningMapper">
    <!-- 单行全局就绪断言不读取租户内容，不写入或绕过历史迁移切换事实。 -->
    <select id="authenticationReady" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM organization_access.tenant_lifecycle_authentication_cutover
            WHERE singleton_key IS TRUE
        )
    </select>
</mapper>
