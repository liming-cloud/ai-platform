<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiplatform.foundation.knowledgedata.infrastructure.persistence.datasource.mapper.TextDataSourceMapper">

    <resultMap id="textDataSourceEntity" type="com.aiplatform.foundation.knowledgedata.infrastructure.persistence.datasource.entity.TextDataSourceEntity">
        <result column="tenant_id" property="tenantId"/>
        <result column="knowledge_space_id" property="knowledgeSpaceId"/>
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="content_version" property="contentVersion"/>
        <result column="published_content_version" property="publishedContentVersion"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="lockTenant" resultType="java.lang.String">
        <![CDATA[
        SELECT pg_advisory_xact_lock(hashtextextended(#{tenantId}, 20260728))
        ]]>
    </select>

    <select id="findByIdForUpdate" resultMap="textDataSourceEntity">
        <![CDATA[
        SELECT tenant_id,
               knowledge_space_id,
               id,
               name,
               status,
               version,
               content_version,
               published_content_version,
               created_by,
               created_at
        FROM knowledge_data.text_data_source
        WHERE tenant_id = #{tenantId}
          AND knowledge_space_id = #{knowledgeSpaceId}
          AND id = #{id}
        FOR UPDATE
        ]]>
    </select>

    <insert id="insertOutboxEvent">
        <![CDATA[
        INSERT INTO knowledge_data.outbox_event (
            tenant_id,
            event_id,
            aggregate_type,
            aggregate_id,
            event_type,
            payload,
            occurred_at
        ) VALUES (
            #{tenantId},
            #{eventId},
            'TEXT_DATA_SOURCE',
            #{aggregateId},
            #{eventType},
            CAST(#{payload} AS JSONB),
            #{occurredAt}
        )
        ]]>
    </insert>
</mapper>
