<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiplatform.identity.infrastructure.persistence.mapper.DelegatedTenantActionMapper">
    <resultMap id="DelegatedTenantActionResultMap"
               type="com.aiplatform.identity.infrastructure.persistence.entity.DelegatedTenantActionPersistenceEntity">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="actionType" column="action_type"/>
        <result property="targetResourceType" column="target_resource_type"/>
        <result property="targetResourceId" column="target_resource_id"/>
        <result property="reason" column="reason"/>
        <result property="requestHash" column="request_hash"/>
        <result property="auditEventId" column="audit_event_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="version" column="version"/>
    </resultMap>

    <select id="findByRequestHash" resultMap="DelegatedTenantActionResultMap">
        SELECT id,
               tenant_id,
               operator_id,
               action_type,
               target_resource_type,
               target_resource_id,
               reason,
               request_hash,
               audit_event_id,
               status,
               created_at,
               updated_at,
               version
        FROM iam_delegated_tenant_action
        WHERE tenant_id = #{tenantId}
          AND operator_id = #{operatorId}
          AND request_hash = #{requestHash}
    </select>

    <select id="insertAction" resultType="long" affectData="true">
        INSERT INTO iam_delegated_tenant_action (
            tenant_id,
            operator_id,
            action_type,
            target_resource_type,
            target_resource_id,
            reason,
            request_hash,
            audit_event_id,
            status,
            created_at,
            updated_at,
            version
        )
        VALUES (
            #{tenantId},
            #{operatorId},
            #{actionType},
            #{targetResourceType},
            #{targetResourceId},
            #{reason},
            #{requestHash},
            #{auditEventId},
            #{status},
            now(),
            now(),
            0
        )
        ON CONFLICT (tenant_id, operator_id, request_hash) DO NOTHING
        RETURNING id
    </select>
</mapper>
