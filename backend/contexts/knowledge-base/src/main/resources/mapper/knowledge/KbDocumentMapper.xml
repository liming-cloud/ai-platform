<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiplatform.knowledge.infrastructure.persistence.mapper.KbDocumentMapper">
    <select id="nextDocumentId" resultType="java.lang.Long">
        SELECT nextval('kb_document_id_seq')
    </select>

    <select id="lockById" resultType="java.lang.Long">
        SELECT id
        FROM kb_document
        WHERE tenant_id = #{tenantId}
          AND knowledge_base_id = #{knowledgeBaseId}
          AND id = #{documentId}
          AND deleted_at IS NULL
        FOR UPDATE
    </select>
</mapper>
