{
  "name": "ai-platform-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "e2e:deploy": "E2E_SKIP_DEPLOY_PROVISION=true playwright test --config=playwright.config.ts login.smoke.spec.ts role-journeys.acceptance.spec.ts --grep \"login entry|进入任务首页、保持安全上下文\"",
    "e2e:contract": "node --test e2e/*.contract.mjs",
    "e2e:list": "npm run e2e:contract && playwright test --config=playwright.config.ts --list",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.68.0",
    "@fluentui/react-icons": "^2.0.303",
    "@fluentui/react-tabster": "^9.26.16",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tabster": "8.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
